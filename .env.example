# Copy this file to .env.local and fill in real values.
# Nothing in this file is committed with real secrets — .env* is gitignored.

# --- Site identity (used in metadata, footer, contact links) ---
NEXT_PUBLIC_SITE_URL=https://www.stellasportsacademy.org
NEXT_PUBLIC_CONTACT_EMAIL=info@stellasportsacademy.org
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# --- Email (Resend) ---
# Without these, forms still "succeed" for visitors but notifications are
# only logged server-side (see src/lib/email.ts) — nothing is silently lost,
# but nothing is delivered either until these are set.
RESEND_API_KEY=
EMAIL_FROM="Stella Sports Academy <donations@yourdomain.org>"
ADMIN_NOTIFY_EMAIL=admin@stellasportsacademy.org

# --- Stripe (donations) ---
# Without STRIPE_SECRET_KEY, the /donate page shows an honest "online giving
# isn't connected yet" message instead of a fake success state.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
