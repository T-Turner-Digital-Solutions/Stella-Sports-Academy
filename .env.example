# Copy this file to .env.local and fill in real values.
# Nothing in this file is committed with real secrets — .env* is gitignored.

# --- Site identity (used in metadata, footer, contact links) ---
NEXT_PUBLIC_SITE_URL=https://www.stellarsportsacademy.org
NEXT_PUBLIC_CONTACT_EMAIL=info@stellarsportsacademy.org
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# --- Email (Resend) ---
# Without these, forms still "succeed" for visitors but notifications are
# only logged server-side (see src/lib/email.ts) — nothing is silently lost,
# but nothing is delivered either until these are set.
RESEND_API_KEY=
EMAIL_FROM="Stellar Sports Academy <donations@yourdomain.org>"
ADMIN_NOTIFY_EMAIL=admin@stellarsportsacademy.org

# --- Stripe (donations) ---
# Without STRIPE_SECRET_KEY, the /donate page shows an honest "online giving
# isn't connected yet" message instead of a fake success state.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Admin section (/admin) — board member accounts for reviewing athlete
# applications, volunteer sign-ups, sponsorship inquiries, contact
# submissions, and donations. These four vars bootstrap the FIRST (owner)
# account only — every account after that is created via an in-app invite
# from /admin/team. See README "Admin Section" for full setup steps,
# including a required one-time schema run.
#
# IMPORTANT: bcrypt hashes and any value containing "$" MUST have every "$"
# escaped as "\$" in .env files, or Next.js's built-in $VAR expansion will
# silently corrupt the value (this is Next.js .env-file behavior, not
# specific to this field). This does NOT apply to env vars set directly in
# Netlify's dashboard — only to literal .env/.env.local files.
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
